<Window x:Class="WinRadial.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinRadial Control Center" Height="650" Width="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="White" MouseDown="Window_MouseDown" Topmost="True">
    
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A1E"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#222226"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1A1A1E" CornerRadius="12" BorderBrush="#33333C" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/> <!-- Sidebar -->
                <ColumnDefinition Width="1"/>   <!-- Separator -->
                <ColumnDefinition Width="*"/>   <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#111113">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="WinRadial" FontWeight="Bold" FontSize="18" Foreground="#E0E0E0" Margin="20,0,0,30"/>
                    <RadioButton x:Name="NavApps" Content="Add Programs" GroupName="Nav" IsChecked="True" Checked="Nav_Checked" Style="{StaticResource NavButtonStyle}"/>
                    <RadioButton x:Name="NavAppearance" Content="Appearance" GroupName="Nav" Checked="Nav_Checked" Style="{StaticResource NavButtonStyle}"/>
                    <RadioButton x:Name="NavEditor" Content="Wheel Layout" GroupName="Nav" Checked="Nav_Checked" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </Border>
            
            <Rectangle Grid.Column="1" Fill="#222226"/>

            <!-- Main Content Area -->
            <Grid Grid.Column="2" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="*"/>    <!-- Content Panels -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblTitle" Grid.Row="0" Text="Add Programs" FontWeight="SemiBold" FontSize="18" Foreground="#E0E0E0" Margin="0,0,0,15"/>

                <!-- PANEL: APPS -->
                <Grid x:Name="PanelApps" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Grid.Row="0" Background="#26262B" CornerRadius="6" BorderBrush="#33333C" BorderThickness="1" Margin="0,0,0,15">
                        <TextBox x:Name="SearchBox" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6"
                                 TextChanged="SearchBox_TextChanged"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 Text="Search..."/>
                    </Border>

                    <!-- Location Options -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Target Location" FontWeight="Medium" Foreground="#AAAAAA" Margin="0,0,0,8"/>
                        <RadioButton x:Name="RbOuterRing" Content="Add to an existing Submenu" Foreground="#DDDDDD" IsChecked="True" Checked="RbLocation_Checked" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CategoryCombo" Margin="24,0,0,10" Background="#26262B" Foreground="Black" BorderBrush="#33333C" Padding="4"/>
                        <RadioButton x:Name="RbInnerRing" Content="Create as a new Category (Inner Ring)" Foreground="#DDDDDD" Checked="RbLocation_Checked"/>
                    </StackPanel>

                    <!-- List -->
                    <Border Grid.Row="2" Background="#111113" CornerRadius="6" BorderBrush="#222226" BorderThickness="1">
                        <Grid>
                            <ListBox x:Name="AppList" Background="Transparent" Foreground="White" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     SelectionChanged="AppList_SelectionChanged"
                                     MouseDoubleClick="AppList_MouseDoubleClick"
                                     PreviewMouseWheel="AppList_PreviewMouseWheel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2A2A32"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#3558AA"/>
                                                            <Setter Property="BorderBrush" Value="#4A78D0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="LoadingText" Text="Fetching installed apps..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#777777" FontStyle="Italic"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- PANEL: SETTINGS -->
                <Grid x:Name="PanelSettings" Grid.Row="1" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                        <StackPanel>
                            <!-- Hotkey -->
                            <TextBlock Text="Global Hotkey" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Modifiers (e.g. Ctrl+Alt)" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                                    <Border Background="#26262B" CornerRadius="4" BorderBrush="#33333C" BorderThickness="1">
                                        <TextBox x:Name="TxtModifiers" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Key (e.g. Space)" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                                    <Border Background="#26262B" CornerRadius="4" BorderBrush="#33333C" BorderThickness="1">
                                        <TextBox x:Name="TxtKey" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Geometry -->
                            <TextBlock Text="Wheel Geometry" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,10,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Inner Radius" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                                <Slider x:Name="SldInner" Grid.Column="1" Minimum="20" Maximum="150" Value="60" Margin="10,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="LblInner" Grid.Column="2" Text="60" VerticalAlignment="Center" Foreground="#888"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Outer Radius" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                                <Slider x:Name="SldOuter" Grid.Column="1" Minimum="100" Maximum="350" Value="200" Margin="10,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="LblOuter" Grid.Column="2" Text="200" VerticalAlignment="Center" Foreground="#888"/>
                            </Grid>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SubMenu Radius" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                                <Slider x:Name="SldSub" Grid.Column="1" Minimum="150" Maximum="450" Value="280" Margin="10,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="LblSub" Grid.Column="2" Text="280" VerticalAlignment="Center" Foreground="#888"/>
                            </Grid>

                            <!-- Appearance -->
                            <TextBlock Text="Appearance" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,10,0,10"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                                <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="0.1" Maximum="1.0" Value="0.97" LargeChange="0.1" SmallChange="0.01" Margin="10,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="LblOpacity" Grid.Column="2" Text="0.97" VerticalAlignment="Center" Foreground="#888"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Background Color" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                                <Border Grid.Column="1" Background="#26262B" CornerRadius="4" BorderBrush="#33333C" BorderThickness="1">
                                    <TextBox x:Name="TxtBgColor" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6" ToolTip="#AARRGGBB"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Accent Color" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                                <Border Grid.Column="1" Background="#26262B" CornerRadius="4" BorderBrush="#33333C" BorderThickness="1">
                                    <TextBox x:Name="TxtAccentColor" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6" ToolTip="#AARRGGBB"/>
                                </Border>
                            </Grid>

                            <!-- Error Text -->
                            <TextBlock x:Name="LblError" Foreground="#FF5555" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PANEL: WHEEL EDITOR -->
                <Grid x:Name="PanelEditor" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#111113" CornerRadius="8" BorderBrush="#222226" BorderThickness="1" Margin="0,0,0,15" ClipToBounds="True">
                        <!-- We will host the WheelCanvas in here programmatically via C# -->
                        <Grid x:Name="PreviewWheelHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" MouseDown="PreviewWheelHost_MouseDown"/>
                    </Border>
                    
                    <TextBlock Grid.Row="1" Text="Click any wheel segment above to assign, edit, or remove programs." Foreground="#888" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                </Grid>

                <!-- Action Buttons -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="BtnRestoreDefaults" Grid.Column="1" Content="Restore Defaults" Width="110" Padding="8,6" Margin="0,0,10,0" 
                            Background="#AA4444" Foreground="White" BorderThickness="0" Click="BtnRestoreDefaults_Click" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button x:Name="BtnPrimary" Grid.Column="2" Content="Add Program" Width="100" Padding="8,6" Margin="0,0,10,0" 
                            Background="#3558AA" Foreground="White" BorderThickness="0" Click="BtnPrimary_Click" IsEnabled="False">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button x:Name="BtnCancel" Grid.Column="3" Content="Cancel" Width="80" Padding="8,6" 
                            Background="#33333C" Foreground="White" BorderThickness="0" Click="BtnCancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
