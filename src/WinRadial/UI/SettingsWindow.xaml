<Window x:Class="WinRadial.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinRadial Settings" Height="650" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="White" MouseDown="Window_MouseDown" Topmost="True">
    <Border Background="#1A1A1E" CornerRadius="12" BorderBrush="#33333C" BorderThickness="1" ClipToBounds="True">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <TextBlock Grid.Row="0" Text="WinRadial Settings" FontWeight="SemiBold" FontSize="18" Foreground="#E0E0E0" Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                <StackPanel>
                    
                    <!-- Hotkey -->
                    <TextBlock Text="Global Hotkey" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,10,0,10"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Modifiers (e.g. Ctrl+Alt)" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <Border Background="#26262B" CornerRadius="4" BorderBrush="#33333C" BorderThickness="1">
                                <TextBox x:Name="TxtModifiers" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Key (e.g. Space)" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <Border Background="#26262B" CornerRadius="4" BorderBrush="#33333C" BorderThickness="1">
                                <TextBox x:Name="TxtKey" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Geometry -->
                    <TextBlock Text="Wheel Geometry" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,10,0,10"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Inner Radius" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <Slider x:Name="SldInner" Grid.Column="1" Minimum="20" Maximum="150" Value="60" Margin="10,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock x:Name="LblInner" Grid.Column="2" Text="60" VerticalAlignment="Center" Foreground="#888"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Outer Radius" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <Slider x:Name="SldOuter" Grid.Column="1" Minimum="100" Maximum="350" Value="200" Margin="10,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock x:Name="LblOuter" Grid.Column="2" Text="200" VerticalAlignment="Center" Foreground="#888"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SubMenu Radius" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <Slider x:Name="SldSub" Grid.Column="1" Minimum="150" Maximum="450" Value="280" Margin="10,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock x:Name="LblSub" Grid.Column="2" Text="280" VerticalAlignment="Center" Foreground="#888"/>
                    </Grid>

                    <!-- Appearance -->
                    <TextBlock Text="Appearance" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,10,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="0.1" Maximum="1.0" Value="0.97" LargeChange="0.1" SmallChange="0.01" Margin="10,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock x:Name="LblOpacity" Grid.Column="2" Text="0.97" VerticalAlignment="Center" Foreground="#888"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Background Color" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <Border Grid.Column="1" Background="#26262B" CornerRadius="4" BorderBrush="#33333C" BorderThickness="1">
                            <TextBox x:Name="TxtBgColor" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6" ToolTip="#AARRGGBB"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Accent Color" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <Border Grid.Column="1" Background="#26262B" CornerRadius="4" BorderBrush="#33333C" BorderThickness="1">
                            <TextBox x:Name="TxtAccentColor" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6" ToolTip="#AARRGGBB"/>
                        </Border>
                    </Grid>

                    <!-- Error Text -->
                    <TextBlock x:Name="LblError" Foreground="#FF5555" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BtnSave" Grid.Column="1" Content="Save" Width="80" Padding="8,6" Margin="0,0,10,0" 
                        Background="#3558AA" Foreground="White" BorderThickness="0" Click="BtnSave_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button x:Name="BtnCancel" Grid.Column="2" Content="Cancel" Width="80" Padding="8,6" 
                        Background="#33333C" Foreground="White" BorderThickness="0" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
