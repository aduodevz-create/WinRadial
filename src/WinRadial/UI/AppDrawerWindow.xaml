<Window x:Class="WinRadial.UI.AppDrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Program" Height="450" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White"
        WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,10" Padding="5" 
                 Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46"
                 TextChanged="SearchBox_TextChanged"
                 GotFocus="SearchBox_GotFocus"
                 LostFocus="SearchBox_LostFocus"
                 Text="Search..."/>

        <ListBox x:Name="AppList" Grid.Row="1" Background="#1E1E1E" Foreground="White" 
                 BorderBrush="#3F3F46" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 SelectionChanged="AppList_SelectionChanged"
                 MouseDoubleClick="AppList_MouseDoubleClick"
                 PreviewMouseWheel="AppList_PreviewMouseWheel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Padding="5" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Loading apps..." 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAdd" Grid.Column="1" Content="Add" Width="70" Padding="5" Margin="0,0,10,0" 
                    Background="#3F3F46" Foreground="White" BorderThickness="0"
                    Click="BtnAdd_Click" IsEnabled="False"/>
            <Button x:Name="BtnCancel" Grid.Column="2" Content="Cancel" Width="70" Padding="5" 
                    Background="#3F3F46" Foreground="White" BorderThickness="0"
                    Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
